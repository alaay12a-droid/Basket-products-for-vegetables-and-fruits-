{
  "expo": {
    "name": "منتجات السلة للخضار والفواكه",
    "slug": "basket-products-",
    "version": "1.4.3",
    "orientation": "portrait",
    "icon": "./assets/images/sallat-alkhodar-logo.png",
    "scheme": "basket-products",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/sallat-alkhodar-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#123D24"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.basket.products",
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleDisplayName": "سلة الخضار والفواكه",
        "NSLocationWhenInUseUsageDescription": "نحتاج موقعك لتحديد عنوان التوصيل وتوفير خدمة أفضل",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.basket.products",
      "googleServicesFile": "./google-services.json",
      "versionCode": 36,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/sallat-alkhodar-logo.png",
        "backgroundColor": "#123D24"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "platforms": [
      "android",
      "ios"
    ],
    "web": {
      "favicon": "./assets/images/sallat-alkhodar-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نحتاج موقعك لتحديد عنوان التوصيل وتوفير خدمة أفضل"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/sallat-alkhodar-logo.png",
          "color": "#237A3B",
          "defaultChannel": "orders",
          "sounds": [
            "./assets/sounds/notification.wav",
            "./assets/sounds/notification_loop.wav",
            "./assets/sounds/order_arrived.m4a",
            "./assets/sounds/new_order.mp3"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "b445091a-537c-453e-a757-a6b87a0174e3"
      }
    },
    "owner": "021837ala"
  }
}
